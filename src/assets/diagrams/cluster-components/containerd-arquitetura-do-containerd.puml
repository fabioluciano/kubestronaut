@startuml

skinparam monochrome true
skinparam backgroundColor white
skinparam defaultFontName monospace

title Arquitetura do ContainerD

package "Control Plane" {
    [kubelet] as kubelet
}

package "ContainerD" {
    [CRI Plugin] as cri
    [Image Service] as images
    [Container Service] as containers
    [Snapshotter] as snap
    [Content Store] as content
    [Metadata Store] as metadata
}

package "Low-Level Runtime" {
    [runc] as runc
    [kata-containers] as kata
    [gVisor] as gvisor
}

package "Storage" {
    database "BoltDB" as bolt
    folder "Snapshots" as snapdir
    folder "Content" as contentdir
}

kubelet --> cri : gRPC (CRI)
cri --> images
cri --> containers
images --> content
images --> snap
containers --> snap
containers --> metadata
snap --> snapdir
content --> contentdir
metadata --> bolt
containers --> runc
containers --> kata
containers --> gvisor

@enduml